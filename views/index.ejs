<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Home Page</title>
</head>
<body>
    <%- include('partials/_navbar.ejs') %>
    <% if (user) { %>
    <main class="dashboard">
    <h1>Welcome back, <%= user.username %></h1>
    <p class="subtitle">
    Here's a quick overview of your subscriptions and upcoming renewals
    </p>

    <section class="dashboard-section">
    <h2><img src="/stylesheets/assets/overview.png" class="section-icon" alt="">Your Overview</h2>
    <p class="stat-line"><span><span class="dot dot-active"></span>Active subscriptions:</span> <strong><%= subscriptions.active.length %></strong></p>
    <p class="stat-line"><span><span class="dot dot-paused"></span>Paused subscriptions: </span><strong><%= subscriptions.paused.length %></strong></p>
    <p class="stat-line"><span><span class="dot dot-cancelled"></span>Cancelled subscriptions:</span><strong> <%= subscriptions.cancelled.length %></strong></p>
    </section>
    
    <section class="dashboard-section">
    <h2><img src="/stylesheets/assets/spend.png" class="section-icon" alt="">Estimated Monthly Spend</h2>

    <% if (Object.keys(totalMonthlyCostByCurrency).length === 0) { %>
  <p>No active subscriptions to calculate yet.</p>
<% } else { %>
<ul class="currency-list">
  <% Object.keys(totalMonthlyCostByCurrency).forEach(currency => { %>
    <li>
     <span> <%= currency %>:</span><span> <%= totalMonthlyCostByCurrency[currency].toFixed(2) %> </span>
    </li>
  <% }) %>
</ul>
<% } %>
    </section>

    <section class="dashboard-section">
    <h2><img src="/stylesheets/assets/upcoming.png" class="section-icon" alt="">Upcoming Renewals</h2>

    <% if (upcomingRenewals.length > 0) { %>
      <ul>
        <% upcomingRenewals.forEach(sub => { %>
          <li class="renewal-item">
            <a href="/subscriptions/<%= sub._id %>">
              <%= sub.serviceName %>
            </a>
            <div class="renewal-meta">
             <span>
            Renews on:
            <%= sub.renewalDate
              ? new Date(sub.renewalDate).toDateString()
              : 'N/A' %> 
             </span>

              <span class="renewal-price">
            <%= sub.currency %> <%= Number(sub.price).toFixed(2) %> -
            (<%= sub.subType %>)
              </span>
              </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No upcoming renewals in the next 30 days</p>
    <% } %>
    </section>
    </main>

  <% } else { %>
    <main class="landing">
        <div class="auth-brand">
      <img
        src="/stylesheets/assets/KEEPR.svg"
        alt="KEEPR logo"
        class="auth-logo"
      />
      <span class="auth-name">KEEPR</span>
    </div>
    <!-- <h1>Welcome to KEEPR</h1> -->
    <p class="subtitle"> Track your subscriptions, avoid surprise charges, and stay in control.</p>

    <div class="landing-actions">
      <form action="/auth/sign-up" method="GET">
    <button type="submit">Get started</button>
  </form>


      <p>
        Already have an account?
        <a href="/auth/sign-in">Sign in</a>
      </p>
    </div>
    </main>
    <% } %>

</body>
</html>