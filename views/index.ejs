<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>Home Page</title>
</head>
<body>
    <%- include('partials/_navbar.ejs') %>
    <% if (user) { %>
    <main class="dashboard">
    <h1>Welcome back, <%= user.username %></h1>
    <p class="subtitle">
    Here's a quick overview of your subscriptions and upcoming renewals
    </p>

    <section class="dashboard-section">
    <h2>Your Overview</h2>
    <p>Active subscriptions: <%= subscriptions.active.length %></p>
    <p>Paused subscriptions: <%= subscriptions.paused.length %></p>
    <p>Cancelled subscriptions: <%= subscriptions.cancelled.length %></p>
    </section>
    
    <section class="dashboard-section">
    <h2>Estimated Monthly Spend</h2>

    <% if (Object.keys(totalMonthlyCostByCurrency).length === 0) { %>
  <p>No active subscriptions to calculate yet.</p>
<% } else { %>
<ul>
  <% Object.keys(totalMonthlyCostByCurrency).forEach(currency => { %>
    <li>
      <%= currency %>: <%= totalMonthlyCostByCurrency[currency].toFixed(2) %>
    </li>
  <% }) %>
</ul>
<% } %>
    </section>

    <section class="dashboard-section">
    <h2>Upcoming Renewals</h2>

    <% if (upcomingRenewals.length > 0) { %>
      <ul>
        <% upcomingRenewals.forEach(sub => { %>
          <li>
            <a href="/subscriptions/<%= sub._id %>">
              <%= sub.serviceName %>
            </a>
            <br>
            <small>
            Renews on:
            <br>
            <%= sub.renewalDate
              ? new Date(sub.renewalDate).toDateString()
              : 'N/A' %> 
              <br>
            <%= sub.currency %> <%= Number(sub.price).toFixed(2) %> -
            (<%= sub.subType %>)
            </small>
          </li>
          <br>
        <% }) %>
      </ul>
    <% } else { %>
      <p>No upcoming renewals in the next 30 days</p>
    <% } %>
    </section>
    </main>

  <% } else { %>
    <h1>Welcome to KEEPR</h1>
    <p class="subtitle"> Track your subscriptions, avoid surprise charges, and stay in control.</p>

    <div class="landing-actions">
      <form action="/auth/sign-up" method="GET">
    <button type="submit">Get started</button>
  </form>


      <p>
        Already have an account?
        <a href="/auth/sign-in">Sign in</a>
      </p>
    </div>
    <% } %>

</body>
</html>