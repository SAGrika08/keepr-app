<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= subscription.serviceName %></title>
</head>
<body>
    <%- include('../partials/_navbar.ejs') %>
    <main class="subscription-details">
    <h1>Subscription: <%= subscription.serviceName %></h1>
    <p class="subtitle">Manage and review your service subscription details</p>

    <section class="details">
    <p class="details-row"><strong>Service Name</strong> <%= subscription.serviceName %></p>
    <p class="details-row"><strong>Plan Name</strong> <%= subscription.planName %></p>
    <p class="details-row"><strong>Price</strong>
        <%= subscription.currency %> <%= subscription.price.toFixed(2) %>
    </p>
    <p class="details-row"><strong>Next Renewal</strong>  <%= subscription.renewalDate ? new Date(subscription.renewalDate).toDateString() : 'N/A' %></p>
        <% if (subscription.renewalDate) { %>
        <small>This subscription will renew automatically.</small>
        <% } %>
    <p class="details-row"><strong>Billing Type</strong> <%= subscription.subType %></p>
    <p class="details-row"><strong>Status</strong> <%= subscription.status %></p>
    <p class="details-row"><strong>Notes</strong> <%= subscription.notes || 'No notes added' %></p>
    </section>

    <div class="actions">
    <button type="button" onclick="window.location.href='/subscriptions'">Back</button>
    <button onclick="window.location.href='/subscriptions/<%= subscription._id %>/edit'">Edit Details</button>
   <form action="/subscriptions/<%= subscription._id %>?_method=DELETE" method="POST"
     onsubmit="return confirm('Are you sure you want to delete this subscription?');">
  <button type="submit">Delete</button>
</form>
    </div>
</main>
    </body>
</html>