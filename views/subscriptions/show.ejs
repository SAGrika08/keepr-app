<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= subscription.owner.username %>'s subscriptions</title>
</head>
<body>
    <%- include('../partials/_navbar.ejs') %>
    <h1>Subscription Details for <%= subscription.serviceName %></h1>
    <h2>Details</h2>
    <p><strong>Service Name:</strong> <%= subscription.serviceName %></p>
    <p><strong>Plan Name:</strong> <%= subscription.planName %></p>
    <p><strong>Price:</strong> <%= subscription.price.toFixed(2) %></p>
    <p><strong>Currency:</strong> <%= subscription.currency %></p>
    <p><strong>Renewal Date:</strong>  <%= subscription.renewalDate ? new Date(subscription.renewalDate).toDateString() : 'N/A' %></p>
    <p><strong>Subscription Type:</strong> <%= subscription.subType %></p>
    <p><strong>Status:</strong> <%= subscription.status %></p>
    <p><strong>Notes:</strong> <%= subscription.notes || 'N/A' %></p>
    <button onclick="window.location.href='/subscriptions'">Back to Subscriptions</button>
    <button onclick="window.location.href='/subscriptions/<%= subscription._id %>/edit'">Edit</button>
   <form action="/subscriptions/<%= subscription._id %>?_method=DELETE" method="POST"
     onsubmit="return confirm('Are you sure you want to delete this subscription?');">
  <button type="submit">Delete Subscription</button>
</form>
    
</body>
</html>