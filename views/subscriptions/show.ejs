<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <link rel="stylesheet" href="/stylesheets/style.css" />
    <title><%= subscription.serviceName %></title>
</head>
<body>
    <%- include('../partials/_navbar.ejs') %>
    <main class="subscription-details">
    <h1>Subscription: <%= subscription.serviceName %></h1>
    <p class="subtitle">Manage and review your service subscription details</p>

    <section class="details">
    <p class="details-row"><strong>
         <img src="/stylesheets/assets/menu.png" class="detail-icon" alt="">
         Service Name</strong> <%= subscription.serviceName %></p>
    <p class="details-row"><strong>
         <img src="/stylesheets/assets/plan.png" class="detail-icon" alt="">
         Plan Name</strong> <%= subscription.planName %></p>
    <p class="details-row"><strong>
         <img src="/stylesheets/assets/price-tag.png" class="detail-icon" alt="">
         Price</strong>
        <%= subscription.currency %> <%= subscription.price.toFixed(2) %>
    </p>
    <p class="details-row">
  <strong>
     <img src="/stylesheets/assets/date.png" class="detail-icon" alt="">
     Next Renewal</strong>
  <span class="details-value">
    <%= subscription.renewalDate ? new Date(subscription.renewalDate).toDateString() : 'N/A' %>

    <% if (subscription.renewalDate) { %>
      <small class="renewal-note">*This subscription will renew automatically.</small>
    <% } %>
  </span>
</p>
    <p class="details-row"><strong> 
        <img src="/stylesheets/assets/cycle.png" class="detail-icon" alt="">
        Billing Type</strong> <%= subscription.subType %></p>
    <p class="details-row"><strong>
         <img src="/stylesheets/assets/status.png" class="detail-icon" alt="">
         Status</strong> <%= subscription.status %></p>
    <p class="details-row"><strong>
         <img src="/stylesheets/assets/notes.png" class="detail-icon" alt="">
         Notes</strong> <%= subscription.notes || 'No notes added' %></p>
    </section>

    <div class="actions">
    <button type="button" onclick="window.location.href='/subscriptions'">Back</button>
    <button onclick="window.location.href='/subscriptions/<%= subscription._id %>/edit'">Edit Details</button>
   <form action="/subscriptions/<%= subscription._id %>?_method=DELETE" method="POST"
     onsubmit="return confirm('Are you sure you want to delete this subscription?');">
  <button type="submit">Delete</button>
</form>
    </div>
</main>
    </body>
</html>