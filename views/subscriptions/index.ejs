<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
     <link rel="stylesheet" href="/stylesheets/style.css" />
    <title>My Subscriptions</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>
    <main class="subscriptions">
    <h1>Subscriptions</h1>
    <p class="subtitle">
    Here is a list of all the subscriptions you have added.
    You can filter them by status and sort them by renewal date.
    </p>
    <div class="filter-row">
    <span>Status</span>

    <a href="/subscriptions"
       class="<%= currentStatus === 'All' ? 'active' : '' %>">
      All
    </a>
    <a href="/subscriptions?status=Active"
       class="<%= currentStatus === 'Active' ? 'active' : '' %>">
      Active
    </a>

    <a href="/subscriptions?status=Paused"
       class="<%= currentStatus === 'Paused' ? 'active' : '' %>">
      Paused
    </a>

    <a href="/subscriptions?status=Cancelled"
       class="<%= currentStatus === 'Cancelled' ? 'active' : '' %> ">
      Cancelled
    </a>
  </div>

  <div class="filter-row">
    <span>Order</span>
    <a href="/subscriptions?<%= currentStatus !== 'All' ? 'status=' + currentStatus : '' %>"
   class="<%= currentSort === 'None' ? 'active' : '' %>">
  Default
</a>

    <a href="/subscriptions?<%= currentStatus !== 'All' ? 'status=' + currentStatus + '&' : '' %>sortBy=renewalDate"
   class="<%= currentSort === 'renewalDate' ? 'active' : '' %>">
  Renewing soon
</a>
  </div>

    <% if (subscriptions.length > 0) { %> 
    <ul class="subscription-list">
    <% subscriptions.forEach((subscription) => { %>
     <li class="subscription-item">
      <a href="/subscriptions/<%= subscription._id %>">
        <%= subscription.serviceName %>
      </a>
      <br>
  <small>
    Renews: <%= subscription.renewalDate ? new Date(subscription.renewalDate).toDateString() : 'N/A' %>
  </small>
    </li>
    <% }) %>
    </ul>
    <% } else { %>
    <p>You have not logged any services yet.</p>
    <% } %>
    <div class="action">
    <form action="/subscriptions/new" method="GET">
    <button type="submit">+ Add New Subscription</button>
    </form>
    </div>
    </main>
    </body>
</html>