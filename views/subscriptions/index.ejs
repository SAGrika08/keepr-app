<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Subscriptions</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>
    <h1>Here's all the Subscriptions</h1>
    <h3>Filter by status</h3>
<p>
  <a href="/subscriptions">All</a> |
  <a href="/subscriptions?status=Active">Active</a> |
  <a href="/subscriptions?status=Paused">Paused</a> |
  <a href="/subscriptions?status=Cancelled">Cancelled</a>
</p>

<h3>Sort By</h3>
<p>
  <a href="/subscriptions?<%= currentStatus !== 'All' ? 'status=' + currentStatus + '&' : '' %>sort=renewal">
        Renewing Soon
  </a>
</p>
    <% if (subscriptions.length > 0) { %> 
    <ul>
    <% subscriptions.forEach((subscription) => { %>
     <li>
      <a href="/subscriptions/<%= subscription._id %>">
        <%= subscription.serviceName %>
      </a>
    </li>
    <% }) %>
    </ul>
    <% } else { %>
    <p>You have not logged any services yet.</p>
    <% } %>
    <form action="/subscriptions/new" method="GET">
    <button type="submit">Add New Subscription</button>
    </form>
    </body>
</html>