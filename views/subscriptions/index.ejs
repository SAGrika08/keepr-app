<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Subscriptions</title>
  </head>
  <body>
    <%- include('../partials/_navbar.ejs') %>
    <h1>Here's all the Subscriptions</h1>
    <% if (subscriptions.length > 0) { %> 
    <ul>
    <% subscriptions.forEach((subscription) => { %>
      <li><a href="/subscriptions/<%= subscription._id %>"><%= subscription.serviceName %></a>
    <a href="/subscriptions/<%= subscription._id %>">View more details.</a>
 </li>
    <% }) %>
    </ul>
    <% } else { %>
    <p>You have not logged any services yet.</p>
    <% } %>
    <form action="/subscriptions/new" method="GET">
    <button type="submit">Add New Subscription</button>
    </form>
    </body>
</html>