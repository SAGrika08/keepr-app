<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add a New Subscriptions</title>
</head>
<body>
    <%- include('../partials/_navbar.ejs') %>
    <main class="form-page">
    <h1>Add a Subscription</h1>
    <p class="subtitle">
    Add the details below to start tracking this subscription.
    </p>

    <form class="form"action="/subscriptions" method="POST">

        <div class="form-row">
        <label for="service-name">Service Name</label>
        <input type="text" name="serviceName" id="service-name" placeholder="Netflix, Spotify, Notion..." required/>
        </div>

        <div class="form-row">
        <label for="plan-name">Plan Name</label>
        <input type="text" name="planName" id="plan-name" placeholder="Basic, Premium..." required/>
        </div>

        <div class="form-row">
        <label for="price">Price</label>
        <input type="number" name="price" id="price" min="0" required />
        </div>

        <div class="form-row">      
        <label for="currency">Currency</label>
        <select name="currency" id="currency" required>
            <option value="" disabled selected>Select currency</option>
            <option value="USD">USD ($)</option>
            <option value="EUR">EUR (€)</option>
            <option value="GBP">GBP (£)</option>
            <option value="INR">INR (₹)</option>
        </select>
        </div>

        <div class="form-row">
        <label for="renewal-date">Next Renewal Date</label>
        <input type="date" name="renewalDate" id="renewal-date" required/>
        </div>

        <div class="form-row">
        <label for="sub-type">Billing Type</label>
        <div class="radio-group">
        <input type="radio" name="subType" id="trial" value="Trial" checked />
        <label for="trial">Trial</label>
        <input type="radio" name="subType" id="weekly" value="Weekly" />
        <label for="weekly">Weekly</label>
        <input type="radio" name="subType" id="monthly" value="Monthly" />
        <label for="monthly">Monthly</label>
        <input type="radio" name="subType" id="yearly" value="Yearly" />
        <label for="yearly">Yearly</label>
            </div>
        </div>

         <div class="form-row">
        <label for="status">Status</label>
        <select name="status" id="status" required>
            <option value="" disabled selected>Select status</option>
            <option value="Active">Active</option>
            <option value="Paused">Paused</option>
            <option value="Cancelled">Cancelled</option>
        </select>
        </div>

        <div class="form-row">
        <label for="notes">Notes (optional)</label>
        <textarea name="notes" id="notes" rows="4" cols="50"  placeholder="Any extra details (account email, reminders, cancellation info...)"></textarea>
        </div>

        <div class="form-actions">
        <button type="reset">Clear</button>
        <button type="button" onclick="window.location.href='/subscriptions'">Back</button>
        <button type="submit">Create Subscription</button>
        </div>
        </form>
    </main>
    </body>
</html>